# Keep the serverless bundle small: only portfolio_api/, api/, knowledge/ and requirements.txt matter.
tests/
venv/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
requirements-dev.txt
# pyproject.toml only holds ruff/pytest config. If Vercel sees it, it installs deps
# from it (none!) instead of requirements.txt. Hide it so requirements.txt is used.
pyproject.toml
