# Copy to .env and fill in. NEVER commit .env.
# Production keys live in Vercel env vars (per project) and GitHub Secrets.

# ---- apps/api ----
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# LLM gateway for the AI twin (same design as Mizan). A ladder tried in order: name or
# name:model. A model that hits its limit is skipped until it recovers. A provider with
# no key is left out. Paid last resort: set OPENAI_API_KEY and append ,openai:<model>.
LLM_PROVIDERS=gemini,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
GEMINI_API_KEY=                     # must come from a Google project with the free tier
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
OPENAI_API_KEY=                     # optional paid fallback

# Rate limit (Upstash Redis REST). Empty = in-memory backend (local dev, tests).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_LIMIT_PER_VISITOR_PER_DAY=30
CHAT_GLOBAL_PER_DAY=1500
FIT_LIMIT_PER_VISITOR_PER_DAY=5
FIT_GLOBAL_PER_DAY=100
CONTACT_LIMIT_PER_VISITOR_PER_DAY=5
CONTACT_GLOBAL_PER_DAY=100

# Abuse protection (D10): allowed origins + HMAC secret for the short-lived page session token.
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TOKEN_SECRET=               # openssl rand -hex 32
SESSION_TOKEN_TTL_S=3600

# Recruiter Mode -> Mizan (D5). Internal key is added to Mizan in W3.
MIZAN_API_URL=https://mizan-hr-api.vercel.app
MIZAN_INTERNAL_KEY=                 # must equal INTERNAL_KEY in the Mizan API project
CV_TEXT_URL=https://mohamedibrahim-ai.vercel.app/cv.txt   # plain-text CV served by the web app
FIT_CACHE_TTL_S=86400

# Contact form (Resend free tier)
RESEND_API_KEY=
# Where contact-form messages are delivered. Until a sending domain is verified in Resend,
# this MUST be the Resend account's own email (Resend refuses other recipients with 403).
CONTACT_TO_EMAIL=

# ---- apps/web ----
# Base URL of the API project. Local: http://localhost:8000. Prod: set in the web Vercel project.
API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cashy live demo: address of the denomination model (ONNX, about 22 MB). Production: the file on
# Hugging Face. Local: put the file in apps/web/public/models/ (git-ignored) and use the path below.
# Empty = the demo is not shown.
NEXT_PUBLIC_CASHY_MODEL_URL=/models/cashy-denominations.onnx
