# Copy to .env and fill in. NEVER commit .env.
# Production keys live in Vercel env vars (per project) and GitHub Secrets.

# ---- apps/api ----
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# LLM gateway (same design as Mizan). Provider chain tried in order: name or name:model.
LLM_PROVIDERS=gemini,groq:openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENAI_API_KEY=                     # optional paid fallback

# Rate limit (Upstash Redis REST). Empty = in-memory backend (local dev, tests).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_LIMIT_PER_VISITOR_PER_DAY=30
CHAT_GLOBAL_PER_DAY=500
FIT_LIMIT_PER_VISITOR_PER_DAY=5
FIT_GLOBAL_PER_DAY=100

# Abuse protection (D10): allowed origins + HMAC secret for the short-lived page session token.
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TOKEN_SECRET=               # openssl rand -hex 32

# Recruiter Mode -> Mizan (D5). Internal key is added to Mizan in W3.
MIZAN_API_URL=https://mizan-hr-api.vercel.app
MIZAN_INTERNAL_KEY=

# Contact form (Resend free tier)
RESEND_API_KEY=
CONTACT_TO_EMAIL=                   # TODO(content): owner's public professional email

# ---- apps/web ----
# Base URL of the API project. Local: http://localhost:8000. Prod: set in the web Vercel project.
API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
